# =============================================================================
# TestForge 后端配置模板
# 用法：cp .env.example .env  然后按你的环境改
# 原则：代码里不允许出现任何地址/端口/模型名/密钥字面量
# =============================================================================

# ---------- 应用 ----------
APP_NAME=TestForge
APP_ENV=dev
DEBUG=true
SECRET_KEY=change-me-please-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
API_V1_PREFIX=/api/v1
# JSON 数组格式
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------- 关系库 ----------
# 生产/联调（VMware 里的 PostgreSQL，注意用 +asyncpg 驱动）：
# DATABASE_URL=postgresql+asyncpg://testforge:PASSWORD@192.168.0.xxx:5432/testforge
# 开发兜底（VM 不开机也能跑）：
DATABASE_URL=sqlite+aiosqlite:///./testforge.db

DB_ECHO=false
# 开发期自动建表；生产环境请置 false 并改用 alembic
AUTO_CREATE_TABLES=true

# ---------- Redis / Celery ----------
REDIS_URL=redis://192.168.0.xxx:6379/0
CELERY_BROKER_URL=redis://192.168.0.xxx:6379/1
CELERY_RESULT_BACKEND=redis://192.168.0.xxx:6379/2
# 1 = 同步执行，不需要 Redis（开发期推荐）
CELERY_EAGER=true

# ---------- LangGraph 检查点 ----------
# memory  | sqlite | postgres
LANGGRAPH_CHECKPOINTER=sqlite
CHECKPOINT_SQLITE_PATH=./testforge_checkpoints.db
# postgres 模式用同步 DSN（LangGraph 要求 psycopg，不带 +asyncpg）
CHECKPOINT_DB_URL=postgresql://testforge:PASSWORD@192.168.0.xxx:5432/testforge

# ---------- LLM（硅基流动为主，可切 DeepSeek / 千问）----------
LLM_PROVIDER=siliconflow
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL_LARGE=deepseek-ai/DeepSeek-V3
LLM_MODEL_SMALL=Qwen/Qwen2.5-7B-Instruct
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
# 1 = 不调真实模型，走确定性桩数据（无 Key 也能跑通全图）
LLM_MOCK=true

# ---------- 图行为 ----------
# 1 = 用例生成后暂停等人工审核（TG-04）；开发期建议 0
REQUIRE_REVIEW=false
# 单次执行最多跑多少条用例，以及并行发出的请求数（TE-03）
MAX_CASES_PER_RUN=30
EXECUTOR_CONCURRENCY=5

# ---------- 成本控制（CO-01~CO-04）----------
TOKEN_BUDGET_MONTHLY=5000000
LLM_RATE_LIMIT_PER_PROJECT=10
